[Unit]
Description=Fleeting — local-first capture & memory inbox
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/fleeting/backend
ExecStart=%h/.local/bin/uv run uvicorn fleeting.main:app --host 127.0.0.1 --port 7425
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
